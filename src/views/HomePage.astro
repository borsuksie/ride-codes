---
import BaseLayout from '../layouts/BaseLayout.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import CodeCard from '../components/CodeCard.astro';
import { getDictionary, type Locale } from '../i18n';
import { appsByCountry, countries, extraApps, type Country } from '../data/apps';
import { getAllCodes } from '../lib/codes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const codes = await getAllCodes();

const site = Astro.site ?? new URL('https://example.com');
const pageUrl = new URL(`/${locale}/`, site).toString();

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: t.meta.title,
    url: pageUrl,
    description: t.meta.description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: t.meta.title,
    itemListElement: [
      ...countries.flatMap(({ code }, countryIndex) =>
        appsByCountry(code).map((app, i) => {
          const entry = codes[app.id];
          const copy = t.apps[app.i18nKey === 'yesim' && code === 'JP' ? 'yesimJp' : (app.i18nKey as keyof typeof t.apps)];
          return {
            '@type': 'ListItem',
            position: countryIndex * 10 + i + 1,
            item: {
              '@type': 'Offer',
              name: `${app.name} — ${t.countries[code === 'PL' ? 'poland' : 'japan']}`,
              url: entry.url,
              description: copy.description,
              additionalProperty: {
                '@type': 'PropertyValue',
                name: 'promoCode',
                value: entry.code,
              },
            },
          };
        })
      ),
      ...extraApps().map((app, i) => {
        const entry = codes[app.id];
        const copy = t.apps[app.i18nKey as keyof typeof t.apps];
        return {
          '@type': 'ListItem',
          position: 100 + i + 1,
          item: {
            '@type': 'Offer',
            name: app.name,
            url: entry.url,
            description: copy.description,
            additionalProperty: {
              '@type': 'PropertyValue',
              name: 'promoCode',
              value: entry.code,
            },
          },
        };
      }),
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: t.faq.items.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.a,
      },
    })),
  },
];

function appCopy(i18nKey: string, country: Country) {
  const key = i18nKey === 'yesim' && country === 'JP' ? 'yesimJp' : i18nKey;
  return t.apps[key as keyof typeof t.apps];
}
---

<BaseLayout locale={locale} title={t.meta.title} description={t.meta.description} jsonLd={jsonLd}>
  <header class="site-header">
    <a class="brand" href={`/${locale}/`}>🚕 RideCodes</a>
    <LanguageSwitcher locale={locale} label={t.nav.selectLanguage} />
  </header>

  <main>
    <section class="hero">
      <h1>{t.hero.title}</h1>
      <p>{t.hero.subtitle}</p>
    </section>

    <section class="intro">
      <div>
        <h2>{t.intro.taxiHeading}</h2>
        <p>{t.intro.taxiText}</p>
      </div>
      <div>
        <h2>{t.intro.esimHeading}</h2>
        <p>{t.intro.esimText}</p>
      </div>
    </section>

    {countries.map(({ code }) => (
      <section class="country" id={code === 'PL' ? 'poland' : 'japan'}>
        <h2>{t.countries[code === 'PL' ? 'poland' : 'japan']}</h2>
        <p class="country-intro">{t.countries[code === 'PL' ? 'polandIntro' : 'japanIntro']}</p>
        <div class="grid">
          {appsByCountry(code).map((app) => (
            <CodeCard app={app} entry={codes[app.id]} copy={appCopy(app.i18nKey, code)} card={t.card} locale={locale} />
          ))}
        </div>
      </section>
    ))}

    <section class="country" id="extras">
      <h2>{t.extras.heading}</h2>
      <p class="country-intro">{t.extras.intro}</p>
      <div class="grid">
        {extraApps().map((app) => (
          <CodeCard app={app} entry={codes[app.id]} copy={t.apps[app.i18nKey as keyof typeof t.apps]} card={t.card} locale={locale} />
        ))}
      </div>
    </section>

    <section class="faq">
      <h2>{t.faq.heading}</h2>
      {t.faq.items.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </section>
  </main>

  <footer class="site-footer">
    <p>{t.footer.disclaimer}</p>
    <p>© {new Date().getFullYear()} RideCodes. {t.footer.rights}</p>
  </footer>
</BaseLayout>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border);
    max-width: 960px;
    margin: 0 auto;
  }

  .brand {
    font-weight: 800;
    font-size: 1.2rem;
    text-decoration: none;
    color: var(--text);
  }

  main {
    max-width: 960px;
    margin: 0 auto;
    padding: 1.5rem 1.25rem 3rem;
  }

  .hero {
    padding: 1.5rem 0 2rem;
    text-align: center;
  }

  .hero h1 {
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    margin-bottom: 0.5rem;
  }

  .hero p {
    color: var(--muted);
    max-width: 640px;
    margin: 0 auto;
  }

  .intro {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .intro h2 {
    font-size: 1.1rem;
  }

  .intro p {
    color: var(--muted);
    font-size: 0.92rem;
  }

  .country {
    margin-bottom: 2.5rem;
  }

  .country h2 {
    margin-bottom: 0.25rem;
  }

  .country-intro {
    color: var(--muted);
    margin-top: 0;
    margin-bottom: 1.25rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }

  .faq {
    margin-top: 2rem;
  }

  .faq details {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.75rem 1rem;
    margin-bottom: 0.6rem;
  }

  .faq summary {
    cursor: pointer;
    font-weight: 600;
  }

  .faq p {
    color: var(--muted);
    margin-bottom: 0;
  }

  .site-footer {
    max-width: 960px;
    margin: 0 auto;
    padding: 1.5rem 1.25rem 2.5rem;
    color: var(--muted);
    font-size: 0.8rem;
    border-top: 1px solid var(--border);
  }
</style>
