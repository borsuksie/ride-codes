---
import BaseLayout from '../layouts/BaseLayout.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { getDictionary, type Locale } from '../i18n';
import { countries } from '../data/apps';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);

const site = Astro.site ?? new URL('https://example.com');
const pageUrl = new URL(`/${locale}/`, site).toString();

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: t.meta.title,
    url: pageUrl,
    description: t.meta.description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: t.home.heading,
    itemListElement: countries.map(({ i18nKey }, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'CollectionPage',
        name: t.countryPages[i18nKey].title,
        url: new URL(`/${locale}/${i18nKey}/`, site).toString(),
        about: { '@type': 'Country', name: t.countries[i18nKey] },
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: t.faq.items.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.a,
      },
    })),
  },
];
---

<BaseLayout locale={locale} title={t.meta.title} description={t.meta.description} jsonLd={jsonLd}>
  <header class="site-header">
    <a class="brand" href={`/${locale}/`}>🚕 RideCodes</a>
    <LanguageSwitcher locale={locale} label={t.nav.selectLanguage} />
  </header>

  <main>
    <section class="hero">
      <h1>{t.hero.title}</h1>
      <p>{t.hero.subtitle}</p>
    </section>

    <section class="intro">
      <div>
        <h2>{t.intro.taxiHeading}</h2>
        <p>{t.intro.taxiText}</p>
      </div>
      <div>
        <h2>{t.intro.esimHeading}</h2>
        <p>{t.intro.esimText}</p>
      </div>
    </section>

    <section class="destinations">
      <h2>{t.home.heading}</h2>
      <p class="destinations-intro">{t.home.intro}</p>
      <div class="grid">
        {countries.map(({ i18nKey }) => (
          <a class="destination-card" href={`/${locale}/${i18nKey}/`}>
            <h3>{t.countries[i18nKey]}</h3>
            <p>{t.countries[i18nKey === 'poland' ? 'polandIntro' : 'japanIntro']}</p>
            <span class="cta">{t.home.visitCountry} →</span>
          </a>
        ))}
      </div>
    </section>

    <section class="faq">
      <h2>{t.faq.heading}</h2>
      {t.faq.items.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </section>
  </main>

  <footer class="site-footer">
    <p>{t.footer.disclaimer}</p>
    <p>© {new Date().getFullYear()} RideCodes. {t.footer.rights}</p>
  </footer>
</BaseLayout>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border);
    max-width: 960px;
    margin: 0 auto;
  }

  .brand {
    font-weight: 800;
    font-size: 1.2rem;
    text-decoration: none;
    color: var(--text);
  }

  main {
    max-width: 960px;
    margin: 0 auto;
    padding: 1.5rem 1.25rem 3rem;
  }

  .hero {
    padding: 1.5rem 0 2rem;
    text-align: center;
  }

  .hero h1 {
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    margin-bottom: 0.5rem;
  }

  .hero p {
    color: var(--muted);
    max-width: 640px;
    margin: 0 auto;
  }

  .intro {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .intro h2 {
    font-size: 1.1rem;
  }

  .intro p {
    color: var(--muted);
    font-size: 0.92rem;
  }

  .destinations {
    margin-bottom: 2.5rem;
  }

  .destinations h2 {
    margin-bottom: 0.25rem;
  }

  .destinations-intro {
    color: var(--muted);
    margin-top: 0;
    margin-bottom: 1.25rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }

  .destination-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--text);
    border-top: 3px solid var(--accent);
    transition: background 0.15s ease;
  }

  .destination-card:hover {
    background: var(--surface-2);
  }

  .destination-card h3 {
    margin: 0;
    font-size: 1.3rem;
  }

  .destination-card p {
    margin: 0;
    color: var(--muted);
    flex-grow: 1;
  }

  .destination-card .cta {
    font-weight: 600;
    color: var(--accent);
  }

  .faq {
    margin-top: 2rem;
  }

  .faq details {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.75rem 1rem;
    margin-bottom: 0.6rem;
  }

  .faq summary {
    cursor: pointer;
    font-weight: 600;
  }

  .faq p {
    color: var(--muted);
    margin-bottom: 0;
  }

  .site-footer {
    max-width: 960px;
    margin: 0 auto;
    padding: 1.5rem 1.25rem 2.5rem;
    color: var(--muted);
    font-size: 0.8rem;
    border-top: 1px solid var(--border);
  }
</style>
